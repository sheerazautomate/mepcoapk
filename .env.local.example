# Copy to .env.local (which is git-ignored) and fill in the real values.
#
# The Convex CLI reads CONVEX_DEPLOYMENT / CONVEX_DEPLOY_KEY from .env.local.
# NEVER commit the deploy key — it grants full write access to the deployment.

CONVEX_DEPLOYMENT=dev:determined-dotterel-142

# Deploy key from the Convex dashboard (Settings → Deploy keys).
# Required for `npx convex deploy` and for CI. Keep it quoted.
CONVEX_DEPLOY_KEY='dev:determined-dotterel-142|<paste-your-deploy-key-here>'

# Only needed while running the one-time Supabase migration script.
# SUPABASE_URL=https://uukinwggdaxolqkbcjyj.supabase.co
# SUPABASE_KEY=<supabase anon or service_role key>
